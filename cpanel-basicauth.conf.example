# ============================================================
# PGS — Autenticazione base davanti a un ambiente NON di produzione
#
# Scopo: impedire che qualcuno raggiunga per caso un ambiente di collaudo che
# contiene una copia dei dati reali. I segreti TOTP clonati sono quelli veri,
# quindi senza questa barriera un utente legittimo potrebbe autenticarsi e
# lavorare nell'ambiente sbagliato credendolo la produzione.
#
# NON usare questo file in produzione.
#
# Destinazione (una copia in std E una in ssl), accanto a pgs-proxy.conf:
#   /etc/apache2/conf.d/userdata/std/2_4/<UTENTE>/<DOMINIO>/pgs-basicauth.conf
#   /etc/apache2/conf.d/userdata/ssl/2_4/<UTENTE>/<DOMINIO>/pgs-basicauth.conf
#
# Lo script cpanel-preprod-lock.sh fa tutto questo (compresa la creazione del
# file delle password). Vedi INSTALL_CPANEL.md.
# ============================================================

<Location "/">
    AuthType Basic
    AuthName "PGS - ambiente di pre-produzione"
    AuthUserFile /etc/pgs/preprod.htpasswd
    Require valid-user
</Location>

# Eccezione obbligatoria: AutoSSL valida il dominio scaricando un file sotto
# /.well-known/acme-challenge. Se anche quello chiedesse la password, il
# rinnovo dei certificati fallirebbe silenziosamente alla scadenza.
<Location "/.well-known">
    AuthType None
    Require all granted
</Location>

# ECCEZIONE OBBLIGATORIA su /api.
# L'applicazione autentica le chiamate API con "Authorization: Bearer <JWT>".
# L'autenticazione base usa lo STESSO header: i due schemi non possono
# coesistere sulla stessa richiesta. Senza questa eccezione Apache risponde
#   AH01614: client used wrong authentication scheme
# e l'applicazione smette di funzionare anche per chi ha inserito la password.
<Location "/api">
    AuthType None
    Require all granted
</Location>

# Cosa protegge davvero questa barriera, allora: l'interfaccia. Senza password
# non si carica il client, quindi nessuno puo' usare l'ambiente dal browser —
# che e' lo scopo, evitare che un utente legittimo ci lavori per errore.
# L'API resta raggiungibile da sola, ma continua a richiedere autenticazione
# TOTP e token: non e' un accesso libero ai dati.
# Se serve chiudere anche l'API, l'unica strada senza conflitti e' una
# restrizione per indirizzo IP (Require ip) al posto della password.
